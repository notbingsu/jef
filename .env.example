TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible endpoint, or a claude-* TEXT_MODEL with an Anthropic key.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Calendar API skills: a Google OAuth "Desktop app" client. The token is written on first use.
GOOGLE_CLIENT_SECRETS_JSON=./config/client_secrets.json
GOOGLE_TOKEN_JSON=./config/token.json
GOOGLE_OAUTH_LOCAL_SERVER_PORT=8765
